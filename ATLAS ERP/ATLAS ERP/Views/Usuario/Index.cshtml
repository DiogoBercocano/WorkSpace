@model List<ATLAS_ERP.Models.Usuario>
@{
    ViewBag.Title = "Funcionários - Atlas ERP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Atlas ERP – Funcionários</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #050d1a;
            --panel: #0b1525;
            --card: #0f1e35;
            --card-hover: #132540;
            --border: rgba(100,160,255,0.10);
            --border-md: rgba(100,160,255,0.18);
            --accent: #3b82f6;
            --accent-soft: rgba(59,130,246,0.12);
            --accent-light: #60a5fa;
            --gold: #c9a84c;
            --gold-soft: rgba(201,168,76,0.12);
            --green: #34d399;
            --green-soft: rgba(52,211,153,0.10);
            --red: #f87171;
            --red-soft: rgba(248,113,113,0.10);
            --text: #e8f0fe;
            --muted: #7a9cc8;
            --faint: #3d5270;
            --sidebar-w: 240px;
            --radius: 14px;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            display: flex;
            min-height: 100vh;
        }

        /* FUNDO */
        .bg-layer {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .bg-dots {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle, rgba(59,130,246,0.10) 1px, transparent 1px);
            background-size: 36px 36px;
            mask-image: radial-gradient(ellipse 70% 70% at 60% 40%, black, transparent);
        }

        .bg-glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--panel);
            border-right: 1px solid var(--border);
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            padding: 28px 16px;
            z-index: 100;
        }

        .sidebar-logo {
            padding: 0 8px;
            margin-bottom: 36px;
        }

            .sidebar-logo img {
                width: 110px;
                filter: brightness(0) invert(1);
            }

        .sidebar-divider {
            height: 1px;
            background: var(--border);
            margin: 8px 0 16px;
        }

        .menu-label {
            font-size: 10px;
            font-weight: 500;
            color: var(--faint);
            text-transform: uppercase;
            letter-spacing: 0.10em;
            padding: 0 12px;
            margin-bottom: 6px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--muted);
            text-decoration: none;
            font-size: 14px;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 2px;
            transition: background 0.18s, color 0.18s;
            position: relative;
        }

            .menu-item svg {
                width: 16px;
                height: 16px;
                flex-shrink: 0;
                opacity: 0.7;
            }

            .menu-item:hover {
                background: var(--card);
                color: var(--text);
            }

                .menu-item:hover svg {
                    opacity: 1;
                }

            .menu-item.active {
                background: var(--accent-soft);
                color: var(--accent-light);
                font-weight: 500;
            }

                .menu-item.active svg {
                    opacity: 1;
                }

                .menu-item.active::before {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 20%;
                    bottom: 20%;
                    width: 3px;
                    background: var(--accent);
                    border-radius: 0 3px 3px 0;
                }

            .menu-item.danger {
                color: var(--red);
            }

                .menu-item.danger:hover {
                    background: var(--red-soft);
                }

        .sidebar-spacer {
            flex: 1;
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--card);
        }

        .user-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--accent-soft);
            border: 1px solid var(--border-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--accent-light);
            flex-shrink: 0;
        }

        .user-name {
            font-size: 13px;
            font-weight: 500;
            color: var(--text);
        }

        .user-role {
            font-size: 11px;
            color: var(--faint);
        }

        /* MAIN */
        .main {
            margin-left: var(--sidebar-w);
            flex: 1;
            padding: 32px 36px;
            position: relative;
            z-index: 1;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
        }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 22px;
            font-weight: 700;
        }

        .page-subtitle {
            font-size: 13px;
            color: var(--muted);
            margin-top: 2px;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--accent);
            color: white;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            padding: 10px 18px;
            border-radius: 10px;
            transition: background 0.18s, transform 0.15s;
            box-shadow: 0 4px 16px rgba(59,130,246,0.25);
        }

            .btn-primary:hover {
                background: #2563eb;
                transform: translateY(-1px);
            }

            .btn-primary svg {
                width: 15px;
                height: 15px;
            }

        /* TABELA */
        .table-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            animation: fadeUp 0.5s ease both;
        }

        .table-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 24px 14px;
            border-bottom: 1px solid var(--border);
        }

        .table-title {
            font-family: 'Syne', sans-serif;
            font-size: 15px;
            font-weight: 700;
        }

        .badge-count {
            font-size: 11px;
            background: var(--accent-soft);
            color: var(--accent-light);
            border: 1px solid rgba(59,130,246,0.2);
            padding: 3px 10px;
            border-radius: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            font-size: 11px;
            color: var(--faint);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            font-weight: 500;
            padding: 10px 24px;
            text-align: left;
            background: rgba(0,0,0,0.15);
        }

        tbody tr {
            border-top: 1px solid var(--border);
            transition: background 0.15s;
        }

            tbody tr:hover {
                background: var(--card-hover);
            }

        tbody td {
            padding: 13px 24px;
            font-size: 14px;
        }

        .td-muted {
            color: var(--muted);
            font-size: 13px;
        }

        /* badges de role */
        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            padding: 3px 10px;
            border-radius: 20px;
        }

            .role-badge.admin {
                background: var(--accent-soft);
                color: var(--accent-light);
            }

            .role-badge.gerente {
                background: var(--gold-soft);
                color: var(--gold);
            }

            .role-badge.outros {
                background: rgba(100,160,255,0.06);
                color: var(--muted);
            }

        /* badge ativo/inativo */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            padding: 3px 10px;
            border-radius: 20px;
        }

            .status-badge.ativo {
                background: var(--green-soft);
                color: var(--green);
            }

            .status-badge.inativo {
                background: var(--red-soft);
                color: var(--red);
            }

        .status-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

        /* avatar inicial */
        .row-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--accent-soft);
            border: 1px solid var(--border-md);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-size: 12px;
            font-weight: 700;
            color: var(--accent-light);
            margin-right: 8px;
            vertical-align: middle;
        }

        .empty-state {
            padding: 48px;
            text-align: center;
            color: var(--faint);
            font-size: 13px;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 700px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }
        }
    </style>
</head>
<body>

    <div class="bg-layer">
        <div class="bg-dots"></div>
        <div class="bg-glow" style="width:400px;height:400px;top:-100px;right:5%;background:rgba(30,60,130,0.18);"></div>
    </div>

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="~/Content/images/Logo_atlas.png" alt="Atlas ERP" />
        </div>

        <span class="menu-label">Principal</span>

        <a href="/Admin/Dashboard" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
            </svg>
            Dashboard
        </a>

        <a href="/Produto" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            </svg>
            Produtos
        </a>

        <a href="/Cliente" class="menu-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            Clientes
        </a>

        <a href="/Usuario" class="menu-item active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
                <line x1="19" y1="8" x2="19" y2="14" />
                <line x1="22" y1="11" x2="16" y2="11" />
            </svg>
            Funcionários
        </a>

        <div class="sidebar-divider"></div>
        <span class="menu-label">Sistema</span>

        <a href="/Auth/Logout" class="menu-item danger">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Sair
        </a>

        <div class="sidebar-spacer"></div>

        <div class="sidebar-user">
            @{
                var nomeUsuario = Session["UsuarioLogado"]?.ToString() ?? "Usuário";
                var inicial = nomeUsuario.Length > 0 ? nomeUsuario[0].ToString().ToUpper() : "U";
            }
            <div class="user-avatar">@inicial</div>
            <div>
                <div class="user-name">@nomeUsuario</div>
                <div class="user-role">Administrador</div>
            </div>
        </div>
    </aside>

    <!-- CONTEUDO -->
    <main class="main">

        <div class="topbar">
            <div>
                <div class="page-title">Funcionários</div>
                <div class="page-subtitle">Gerencie os acessos do sistema</div>
            </div>
            <a href="/Usuario/Create" class="btn-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="16" />
                    <line x1="8" y1="12" x2="16" y2="12" />
                </svg>
                Novo Funcionário
            </a>
        </div>

        <div class="table-card">
            <div class="table-header">
                <span class="table-title">Todos os Usuários</span>
                <span class="badge-count">@Model.Count registro(s)</span>
            </div>

            @if (Model != null && Model.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Cargo</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var roleClass = u.Role?.ToLower() == "admin" ? "admin"
                                          : u.Role?.ToLower() == "gerente" ? "gerente"
                                          : "outros";

                            <tr>
                                <td>
                                    <span class="row-avatar">@(u.Name?.Length > 0 ? u.Name[0].ToString().ToUpper() : "?")</span>
                                    @u.Name
                                </td>
                                <td class="td-muted">@u.Email</td>
                                <td>
                                    <span class="role-badge @roleClass">@(u.Role ?? "—")</span>
                                </td>
                                <td>
                                    <span class="status-badge @(u.Ativo ? "ativo" : "inativo")">
                                        <span class="status-dot"></span>
                                        @(u.Ativo ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">Nenhum funcionário cadastrado ainda.</div>
            }
        </div>

    </main>

</body>
</html>