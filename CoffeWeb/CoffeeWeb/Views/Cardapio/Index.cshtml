@model IEnumerable<CoffeeWeb.Models.Produto>
@{
    ViewBag.Title = "Cardápio";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --coffee-dark: #1C1208;
            --coffee-mid: #3D2B1A;
            --coffee-warm: #7A4F2D;
            --coffee-gold: #C9923A;
            --coffee-cream: #F5ECD7;
            --coffee-light: #FAF6EE;
            --coffee-muted: #9A8070;
        }

        body {
            background: var(--coffee-light);
            font-family: 'DM Sans', sans-serif;
            color: var(--coffee-dark);
        }

        /* ── HERO DO CARDÁPIO ── */
        .cp-hero {
            padding: 4rem 3rem 3rem;
            border-bottom: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .cp-eyebrow {
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--coffee-gold);
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .cp-eyebrow::before {
                content: '';
                display: block;
                width: 24px;
                height: 1px;
                background: var(--coffee-gold);
            }

        .cp-hero-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2rem, 4vw, 3.5rem);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.02em;
            color: var(--coffee-dark);
            margin: 0;
        }

            .cp-hero-title em {
                font-style: italic;
                color: var(--coffee-warm);
            }

        .cp-hero-count {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            font-weight: 700;
            color: rgba(122,79,45,0.12);
            line-height: 1;
            user-select: none;
        }

        /* ── GRID DE CARDS ── */
        .cp-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 32px;
            padding: 32px;
            border-left: none;
        }

        .cp-card {
            border: 1px solid rgba(122,79,45,0.12);
            border-radius: 4px;
            transition: background 0.2s;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

            .cp-card:hover {
                background: var(--coffee-cream);
            }

        .cp-card-img-wrap {
            position: relative;
            overflow: hidden;
            height: 200px;
            background: var(--coffee-mid);
        }

        .cp-card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
            display: block;
        }

        .cp-card:hover .cp-card-img {
            transform: scale(1.04);
        }

        .cp-price-badge {
            position: absolute;
            bottom: 0;
            left: 0;
            background: var(--coffee-dark);
            color: var(--coffee-cream);
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            padding: 0.4rem 1rem;
            letter-spacing: 0.02em;
        }

        .cp-card-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .cp-card-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin-bottom: 0.5rem;
            line-height: 1.3;
        }

        .cp-card-desc {
            font-size: 0.85rem;
            font-weight: 300;
            color: var(--coffee-muted);
            line-height: 1.6;
            flex: 1;
            margin-bottom: 1.25rem;
        }

        .cp-card-link {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--coffee-gold);
            letter-spacing: 0.05em;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: gap 0.2s;
            border-top: 1px solid rgba(122,79,45,0.12);
            padding-top: 1rem;
            margin-top: auto;
        }

        .cp-card:hover .cp-card-link {
            gap: 10px;
        }

        /* ── EMPTY STATE ── */
        .cp-empty {
            grid-column: 1 / -1;
            padding: 5rem 3rem;
            text-align: center;
        }

        .cp-empty-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--coffee-dark);
            margin-bottom: 0.5rem;
        }

        .cp-empty-desc {
            font-size: 0.875rem;
            color: var(--coffee-muted);
        }

        /* ── ANIMAÇÃO ── */
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .cp-card {
            animation: fadeUp 0.5s ease both;
        }

        /* ── RESPONSIVO ── */
        @@media (max-width: 768px) {
            .cp-hero {
                padding: 2.5rem 1.5rem 2rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }

            .cp-hero-count {
                font-size: 2.5rem;
            }

            .cp-grid {
                grid-template-columns: 1fr 1fr;
                gap: 16px;
                padding: 16px;
            }
        }

        @@media (max-width: 480px) {
            .cp-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- HERO -->
<div class="cp-hero">
    <div>
        <div class="cp-eyebrow">Seleção especial</div>
        <h1 class="cp-hero-title">
            Nosso<br><em>Cardápio</em>
        </h1>
    </div>
    <div class="cp-hero-count">@Model.Count()</div>
</div>

<!-- GRID -->
<div class="cp-grid">
    @if (!Model.Any())
    {
        <div class="cp-empty">
            <div class="cp-empty-title">Nenhum café disponível</div>
            <p class="cp-empty-desc">O cardápio está vazio no momento. Volte em breve!</p>
        </div>
    }
    else
    {
        int i = 0;
        foreach (var cafe in Model)
        {
            <div class="cp-card" style="animation-delay: @(i * 0.07)s">
                <div class="cp-card-img-wrap">
                    <img src="@(string.IsNullOrEmpty(cafe.ImagemUrl)
                            ? Url.Content("~/Content/img/sem-imagem.png")
                            : Url.Content(cafe.ImagemUrl))"
                         class="cp-card-img"
                         alt="@cafe.Nome" />
                    <div class="cp-price-badge">R$ @cafe.Preco.ToString("N2")</div>
                </div>
                <div class="cp-card-body">
                    <div class="cp-card-title">@cafe.Nome</div>
                    <p class="cp-card-desc">
                        @(cafe.Descricao ?? "Sem descrição disponível")
                    </p>
                    <a href="@Url.Action("Detalhes", "Cardapio", new { id = cafe.Id })"
                       class="cp-card-link">
                        Ver detalhes →
                    </a>
                </div>
            </div>
            i++;
        }
    }
</div>