@{
    ViewBag.Title = "Login";
    Layout = null;
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

<style>
    :root {
        --coffee-dark: #1C1208;
        --coffee-mid: #3D2B1A;
        --coffee-warm: #7A4F2D;
        --coffee-gold: #C9923A;
        --coffee-cream: #F5ECD7;
        --coffee-light: #FAF6EE;
        --coffee-muted: #9A8070;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        font-family: 'DM Sans', sans-serif;
        background: var(--coffee-light);
        color: var(--coffee-dark);
    }

    /* ── LADO ESQUERDO (escuro) ── */
    .login-left {
        background: var(--coffee-dark);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        gap: 2rem;
    }

    .login-logo {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--coffee-cream);
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.02em;
    }

    .login-logo-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--coffee-gold);
        display: inline-block;
    }

    .login-cup {
        width: 140px;
        height: 140px;
    }

    .login-tagline {
        text-align: center;
    }

    .login-tagline-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--coffee-cream);
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .login-tagline-title em {
        font-style: italic;
        color: var(--coffee-gold);
    }

    .login-tagline-sub {
        font-size: 0.8rem;
        font-weight: 300;
        color: var(--coffee-muted);
        letter-spacing: 0.03em;
    }

    /* ── LADO DIREITO (formulário) ── */
    .login-right {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem;
        background: var(--coffee-light);
    }

    .login-form-wrap {
        width: 100%;
        max-width: 360px;
    }

    .login-eyebrow {
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--coffee-gold);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .login-eyebrow::before {
        content: '';
        display: block;
        width: 20px;
        height: 1px;
        background: var(--coffee-gold);
    }

    .login-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--coffee-dark);
        margin-bottom: 2rem;
        line-height: 1.2;
    }

    .login-title em {
        font-style: italic;
        color: var(--coffee-warm);
    }

    /* ── INPUTS ── */
    .login-field {
        margin-bottom: 1.25rem;
    }

    .login-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--coffee-muted);
        margin-bottom: 0.4rem;
    }

    .login-input {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 1px solid rgba(122,79,45,0.2);
        border-radius: 2px;
        background: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        color: var(--coffee-dark);
        outline: none;
        transition: border-color 0.2s;
    }

    .login-input:focus {
        border-color: var(--coffee-gold);
    }

    .login-input::placeholder {
        color: rgba(154,128,112,0.5);
    }

    /* ── ERRO ── */
    .login-error {
        background: rgba(180,50,30,0.08);
        border: 1px solid rgba(180,50,30,0.2);
        color: #8B2500;
        font-size: 0.8rem;
        padding: 0.75rem 1rem;
        border-radius: 2px;
        margin-bottom: 1.25rem;
    }

    /* ── BOTÃO ── */
    .login-btn {
        width: 100%;
        padding: 0.9rem;
        background: var(--coffee-dark);
        color: var(--coffee-cream);
        border: none;
        border-radius: 2px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: background 0.2s, transform 0.15s;
        margin-top: 0.5rem;
    }

    .login-btn:hover {
        background: var(--coffee-mid);
        transform: translateY(-1px);
    }

    .login-back {
        display: block;
        text-align: center;
        margin-top: 1.5rem;
        font-size: 0.8rem;
        color: var(--coffee-muted);
        text-decoration: none;
        transition: color 0.2s;
    }

    .login-back:hover {
        color: var(--coffee-gold);
        text-decoration: none;
    }

    /* ── ANIMAÇÃO VAPOR ── */
    @@keyframes steamRise {
        0%   { opacity: 0; transform: translateY(0) scaleX(1); }
        50%  { opacity: 0.6; transform: translateY(-10px) scaleX(1.2); }
        100% { opacity: 0; transform: translateY(-20px) scaleX(0.8); }
    }

    .steam-line {
        animation: steamRise 2.5s ease-in-out infinite;
    }
    .steam-line:nth-child(2) { animation-delay: 0.4s; }
    .steam-line:nth-child(3) { animation-delay: 0.8s; }

    /* ── RESPONSIVO ── */
    @@media (max-width: 768px) {
        body { grid-template-columns: 1fr; }
        .login-left { display: none; }
        .login-right { padding: 2rem 1.5rem; }
    }
</style>

<!-- LADO ESQUERDO -->
<div class="login-left">
    <div class="login-logo">
        <span class="login-logo-dot"></span>
        Coffee Web
    </div>

    <svg class="login-cup" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path class="steam-line" d="M62 38 Q58 28 62 18" stroke="#C9923A" stroke-width="2" stroke-linecap="round" opacity="0" />
        <path class="steam-line" d="M80 35 Q76 22 80 10" stroke="#C9923A" stroke-width="2" stroke-linecap="round" opacity="0" />
        <path class="steam-line" d="M98 38 Q102 28 98 18" stroke="#C9923A" stroke-width="2" stroke-linecap="round" opacity="0" />
        <ellipse cx="80" cy="52" rx="36" ry="8" fill="#7A4F2D" opacity="0.5" />
        <path d="M44 52 L52 128 Q52 136 80 136 Q108 136 108 128 L116 52 Z" fill="#3D2B1A" />
        <path d="M44 52 L52 128 Q52 136 80 136 Q108 136 108 128 L116 52 Z" fill="url(#coffeeGradLogin)" />
        <ellipse cx="80" cy="52" rx="36" ry="8" fill="#5A3520" />
        <ellipse cx="80" cy="52" rx="28" ry="5" fill="#7A4F2D" opacity="0.6" />
        <path d="M116 68 Q132 68 132 84 Q132 100 116 100" stroke="#5A3520" stroke-width="4" fill="none" stroke-linecap="round" />
        <ellipse cx="80" cy="132" rx="32" ry="6" fill="#2A1A0A" opacity="0.3" />
        <defs>
            <linearGradient id="coffeeGradLogin" x1="44" y1="52" x2="116" y2="136" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#5A3520" />
                <stop offset="100%" stop-color="#1C1208" />
            </linearGradient>
        </defs>
    </svg>

    <div class="login-tagline">
        <div class="login-tagline-title">Área <em>restrita</em><br>ao administrador</div>
        <div class="login-tagline-sub">Acesso exclusivo ao painel de gestão</div>
    </div>
</div>

<!-- LADO DIREITO -->
<div class="login-right">
    <div class="login-form-wrap">
        <div class="login-eyebrow">Painel administrativo</div>
        <h1 class="login-title">Bem-vindo<br><em>de volta</em></h1>

        @if (ViewBag.Erro != null)
        {
            <div class="login-error">@ViewBag.Erro</div>
        }

        @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
        {
            <div class="login-field">
                <label class="login-label">E-mail</label>
                <input class="login-input" type="email" name="email" placeholder="seu@email.com" required />
            </div>
            <div class="login-field">
                <label class="login-label">Senha</label>
                <input class="login-input" type="password" name="senha" placeholder="••••••••" required />
            </div>
            <button type="submit" class="login-btn">Entrar →</button>
        }

        <a href="@Url.Action("Index", "Home")" class="login-back">← Voltar para o início</a>
    </div>
</div>