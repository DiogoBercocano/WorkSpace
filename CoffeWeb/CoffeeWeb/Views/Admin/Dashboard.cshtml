@{
    ViewBag.Title = "Dashboard";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --coffee-dark: #1C1208;
            --coffee-mid: #3D2B1A;
            --coffee-warm: #7A4F2D;
            --coffee-gold: #C9923A;
            --coffee-cream: #F5ECD7;
            --coffee-light: #FAF6EE;
            --coffee-muted: #9A8070;
        }

        body {
            background: var(--coffee-light);
            font-family: 'DM Sans', sans-serif;
            color: var(--coffee-dark);
        }

        /* ── HEADER ── */
        .db-header {
            padding: 2rem 3rem;
            border-bottom: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .db-header-left {
        }

        .db-eyebrow {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--coffee-gold);
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .db-eyebrow::before {
                content: '';
                display: block;
                width: 20px;
                height: 1px;
                background: var(--coffee-gold);
            }

        .db-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin: 0;
            line-height: 1.2;
        }

            .db-title em {
                font-style: italic;
                color: var(--coffee-warm);
            }

        .db-logout {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--coffee-muted);
            text-decoration: none;
            letter-spacing: 0.05em;
            border: 1px solid rgba(122,79,45,0.2);
            padding: 0.6rem 1.25rem;
            border-radius: 2px;
            transition: border-color 0.2s, color 0.2s;
        }

            .db-logout:hover {
                border-color: #8B2500;
                color: #8B2500;
                text-decoration: none;
            }

        /* ── BOAS VINDAS ── */
        .db-welcome {
            margin: 2rem 3rem;
            padding: 1.5rem 2rem;
            background: var(--coffee-cream);
            border-left: 3px solid var(--coffee-gold);
            border-radius: 2px;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .db-welcome-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(201,146,58,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .db-welcome-icon svg {
                width: 18px;
                height: 18px;
            }

        .db-welcome-text strong {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--coffee-dark);
            display: block;
        }

        .db-welcome-text span {
            font-size: 0.8rem;
            color: var(--coffee-muted);
            font-weight: 300;
        }

        /* ── GRID DE MÓDULOS ── */
        .db-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 0;
            border-top: 1px solid rgba(122,79,45,0.12);
            border-left: 1px solid rgba(122,79,45,0.12);
            margin: 2rem 3rem;
            border-radius: 2px;
            overflow: hidden;
        }

        .db-card {
            border-right: 1px solid rgba(122,79,45,0.12);
            border-bottom: 1px solid rgba(122,79,45,0.12);
            padding: 2rem;
            transition: background 0.2s;
            display: flex;
            flex-direction: column;
        }

            .db-card:hover {
                background: var(--coffee-cream);
            }

        .db-card-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(201,146,58,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
        }

            .db-card-icon svg {
                width: 20px;
                height: 20px;
            }

        .db-card-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin-bottom: 0.5rem;
        }

        .db-card-desc {
            font-size: 0.85rem;
            font-weight: 300;
            color: var(--coffee-muted);
            line-height: 1.6;
            flex: 1;
            margin-bottom: 1.5rem;
        }

        .db-card-link {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--coffee-gold);
            letter-spacing: 0.05em;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-top: 1px solid rgba(122,79,45,0.12);
            padding-top: 1rem;
            transition: gap 0.2s;
        }

        .db-card:hover .db-card-link {
            gap: 10px;
        }

        /* ── RESPONSIVO ── */
        @@media (max-width: 768px) {
            .db-header {
                padding: 1.5rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .db-welcome {
                margin: 1rem 1.5rem;
            }

            .db-grid {
                margin: 1rem 1.5rem;
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- HEADER -->
<div class="db-header">
    <div class="db-header-left">
        <div class="db-eyebrow">Área restrita</div>
        <h1 class="db-title">Painel de <em>controle</em></h1>
    </div>
    <a href="@Url.Action("Logout", "Admin")" class="db-logout">Sair →</a>
</div>

<!-- BOAS VINDAS -->
<div class="db-welcome">
    <div class="db-welcome-icon">
        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="9" cy="6" r="3" stroke="#C9923A" stroke-width="1.5" />
            <path d="M3 15c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="#C9923A" stroke-width="1.5" stroke-linecap="round" />
        </svg>
    </div>
    <div class="db-welcome-text">
        <strong>Bem-vindo(a), @Session["UsuarioLogado"]!</strong>
        <span>Você acessou uma área restrita do sistema com sucesso.</span>
    </div>
</div>

<!-- MÓDULOS -->
<div class="db-grid">

    <div class="db-card">
        <div class="db-card-icon">
            <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="3" width="14" height="2" rx="1" fill="#C9923A" />
                <rect x="2" y="7" width="10" height="2" rx="1" fill="#C9923A" opacity="0.6" />
                <rect x="2" y="11" width="12" height="2" rx="1" fill="#C9923A" opacity="0.4" />
                <rect x="2" y="15" width="7" height="2" rx="1" fill="#C9923A" opacity="0.3" />
            </svg>
        </div>
        <div class="db-card-title">Gerenciar Produtos</div>
        <p class="db-card-desc">Adicione, edite ou remova cafés do cardápio com facilidade.</p>
        <a href="@Url.Action("Index", "Produto")" class="db-card-link">Acessar módulo →</a>
    </div>

    <div class="db-card">
        <div class="db-card-icon">
            <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="3" width="14" height="2" rx="1" fill="#C9923A" />
                <rect x="2" y="7" width="10" height="2" rx="1" fill="#C9923A" opacity="0.6" />
                <rect x="2" y="11" width="12" height="2" rx="1" fill="#C9923A" opacity="0.4" />
                <rect x="2" y="15" width="7" height="2" rx="1" fill="#C9923A" opacity="0.3" />
            </svg>
        </div>
        <div class="db-card-title">Cardápio</div>
        <p class="db-card-desc">Visualize o cardápio como os clientes o veem.</p>
        <a href="@Url.Action("Index", "Cardapio")" class="db-card-link">Ver cardápio →</a>
    </div>

    <div class="db-card">
        <div class="db-card-icon">
            <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="10" width="3" height="6" rx="1" fill="#C9923A" opacity="0.4" />
                <rect x="7" y="7" width="3" height="9" rx="1" fill="#C9923A" opacity="0.6" />
                <rect x="12" y="3" width="3" height="13" rx="1" fill="#C9923A" />
            </svg>
        </div>
        <div class="db-card-title">Sistema</div>
        <p class="db-card-desc">Informações sobre o sistema e status da aplicação.</p>
        <a href="#" class="db-card-link">Ver detalhes →</a>
    </div>

</div>