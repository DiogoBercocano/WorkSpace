@model CoffeeWeb.Models.Produto
@{
    bool isEdit = Model != null && Model.Id > 0;
    ViewBag.Title = isEdit ? "Editar Produto" : "Novo Produto";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --coffee-dark: #1C1208;
            --coffee-mid: #3D2B1A;
            --coffee-warm: #7A4F2D;
            --coffee-gold: #C9923A;
            --coffee-cream: #F5ECD7;
            --coffee-light: #FAF6EE;
            --coffee-muted: #9A8070;
        }

        body {
            background: var(--coffee-light);
            font-family: 'DM Sans', sans-serif;
            color: var(--coffee-dark);
        }

        /* ── HEADER ── */
        .pf-header {
            padding: 2rem 3rem;
            border-bottom: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .pf-eyebrow {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--coffee-gold);
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pf-eyebrow::before {
                content: '';
                display: block;
                width: 20px;
                height: 1px;
                background: var(--coffee-gold);
            }

        .pf-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin: 0;
            line-height: 1.2;
        }

            .pf-title em {
                font-style: italic;
                color: var(--coffee-warm);
            }

        .pf-btn-back {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--coffee-muted);
            text-decoration: none;
            border: 1px solid rgba(122,79,45,0.2);
            padding: 0.6rem 1.25rem;
            border-radius: 2px;
            transition: border-color 0.2s, color 0.2s;
            letter-spacing: 0.03em;
        }

            .pf-btn-back:hover {
                border-color: var(--coffee-dark);
                color: var(--coffee-dark);
                text-decoration: none;
            }

        /* ── FORM ── */
        .pf-body {
            padding: 2.5rem 3rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }

        .pf-form-col {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .pf-field {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .pf-label {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--coffee-muted);
        }

        .pf-input,
        .pf-textarea {
            padding: 0.875rem 1rem;
            border: 1px solid rgba(122,79,45,0.2);
            border-radius: 2px;
            background: white;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            color: var(--coffee-dark);
            outline: none;
            transition: border-color 0.2s;
            width: 100%;
        }

            .pf-input:focus,
            .pf-textarea:focus {
                border-color: var(--coffee-gold);
            }

            .pf-input::placeholder,
            .pf-textarea::placeholder {
                color: rgba(154,128,112,0.4);
            }

        .pf-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .pf-validation {
            font-size: 0.78rem;
            color: #8B2500;
        }

        /* ── UPLOAD ── */
        .pf-upload-wrap {
            border: 1px dashed rgba(122,79,45,0.3);
            border-radius: 2px;
            padding: 1.5rem;
            background: white;
            text-align: center;
            transition: border-color 0.2s;
        }

            .pf-upload-wrap:hover {
                border-color: var(--coffee-gold);
            }

        .pf-upload-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(201,146,58,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.75rem;
        }

            .pf-upload-icon svg {
                width: 18px;
                height: 18px;
            }

        .pf-upload-text {
            font-size: 0.8rem;
            color: var(--coffee-muted);
            margin-bottom: 0.75rem;
            font-weight: 300;
        }

        .pf-upload-input {
            width: 100%;
            font-size: 0.8rem;
            color: var(--coffee-muted);
            font-family: 'DM Sans', sans-serif;
        }

        .pf-current-img {
            margin-bottom: 1rem;
        }

        .pf-current-label {
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--coffee-muted);
            margin-bottom: 0.5rem;
            display: block;
        }

        .pf-current-photo {
            width: 72px;
            height: 72px;
            object-fit: cover;
            border-radius: 2px;
            border: 1px solid rgba(122,79,45,0.15);
        }

        .pf-hint {
            font-size: 0.75rem;
            color: var(--coffee-muted);
            font-weight: 300;
            margin-top: 0.4rem;
        }

        /* ── PREVIEW LATERAL ── */
        .pf-preview-col {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .pf-preview-card {
            border: 1px solid rgba(122,79,45,0.12);
            border-radius: 2px;
            overflow: hidden;
            background: white;
        }

        .pf-preview-img-wrap {
            height: 200px;
            background: var(--coffee-cream);
            overflow: hidden;
            position: relative;
        }

        .pf-preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .pf-preview-badge {
            position: absolute;
            bottom: 0;
            left: 0;
            background: var(--coffee-dark);
            color: var(--coffee-cream);
            font-family: 'Playfair Display', serif;
            font-size: 0.9rem;
            font-weight: 700;
            padding: 0.35rem 0.9rem;
        }

        .pf-preview-body {
            padding: 1.25rem;
        }

        .pf-preview-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin-bottom: 0.4rem;
        }

        .pf-preview-desc {
            font-size: 0.8rem;
            color: var(--coffee-muted);
            font-weight: 300;
            line-height: 1.5;
        }

        .pf-preview-label {
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--coffee-muted);
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .pf-preview-label::before {
                content: '';
                display: block;
                width: 16px;
                height: 1px;
                background: var(--coffee-muted);
            }

        /* ── BOTÃO SUBMIT ── */
        .pf-footer {
            padding: 1.5rem 3rem;
            border-top: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            align-items: center;
        }

        .pf-btn-submit {
            background: var(--coffee-dark);
            color: var(--coffee-cream);
            border: none;
            padding: 0.875rem 2.5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.875rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            cursor: pointer;
            border-radius: 2px;
            transition: background 0.2s, transform 0.15s;
        }

            .pf-btn-submit:hover {
                background: var(--coffee-mid);
                transform: translateY(-1px);
            }

        @@media (max-width: 768px) {
            .pf-header {
                padding: 1.5rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .pf-body {
                padding: 1.5rem;
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }

            .pf-footer {
                padding: 1.5rem;
            }
        }
    </style>
}

<!-- HEADER -->
<div class="pf-header">
    <div>
        <div class="pf-eyebrow">@(isEdit ? "Editar produto" : "Novo produto")</div>
        <h1 class="pf-title">
            @if (isEdit)
            {
                <span>Editar <em>@Model.Nome</em></span>
            }
            else
            {
                <span>Cadastrar <em>café</em></span>
            }
        </h1>
    </div>
    <a href="@Url.Action("Index")" class="pf-btn-back">← Voltar para a lista</a>
</div>

@using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    if (isEdit)
    {
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.ImagemUrl)
    }

    <div class="pf-body">

        <!-- COLUNA ESQUERDA: campos -->
        <div class="pf-form-col">

            <div class="pf-field">
                <label class="pf-label">Nome do produto</label>
                @Html.TextBoxFor(model => model.Nome, new { @class = "pf-input", placeholder = "Ex: Café Mocha" })
                @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "pf-validation" })
            </div>

            <div class="pf-field">
                <label class="pf-label">Preço (R$)</label>
                @Html.TextBoxFor(model => model.Preco, new { @class = "pf-input", placeholder = "Ex: 12,50" })
                @Html.ValidationMessageFor(model => model.Preco, "", new { @class = "pf-validation" })
            </div>

            <div class="pf-field">
                <label class="pf-label">Descrição</label>
                @Html.TextAreaFor(model => model.Descricao, new { @class = "pf-textarea", placeholder = "Descreva o café, ingredientes, sabor..." })
                @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "pf-validation" })
            </div>

            <div class="pf-field">
                <label class="pf-label">Foto do produto</label>
                <div class="pf-upload-wrap">
                    @if (isEdit && !string.IsNullOrEmpty(Model.ImagemUrl))
                    {
                        <div class="pf-current-img">
                            <span class="pf-current-label">Foto atual</span>
                            <img src="@Url.Content(Model.ImagemUrl)" class="pf-current-photo" alt="@Model.Nome" />
                        </div>
                    }
                    <div class="pf-upload-icon">
                        <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 12V4M9 4L6 7M9 4L12 7" stroke="#C9923A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M3 14h12" stroke="#C9923A" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="pf-upload-text">Clique para selecionar uma imagem</div>
                    <input type="file" name="fotoUpload" id="fotoUpload" class="pf-upload-input" accept="image/*" />
                </div>
                @if (isEdit)
                {
                    <span class="pf-hint">Deixe em branco para manter a foto atual.</span>
                }
            </div>

        </div>

        <!-- COLUNA DIREITA: preview -->
        <div class="pf-preview-col">
            <div class="pf-preview-label">Pré-visualização do card</div>
            <div class="pf-preview-card">
                <div class="pf-preview-img-wrap">
                    <img id="previewImg"
                         src="@(isEdit && !string.IsNullOrEmpty(Model.ImagemUrl) ? Url.Content(Model.ImagemUrl) : Url.Content("~/Content/img/sem-imagem.png"))"
                         class="pf-preview-img"
                         alt="Preview" />
                    <div class="pf-preview-badge" id="previewPreco">
                        R$ @(Model != null ? Model.Preco.ToString("N2") : "0,00")
                    </div>
                </div>
                <div class="pf-preview-body">
                    <div class="pf-preview-name" id="previewNome">
                        @(Model != null && !string.IsNullOrEmpty(Model.Nome) ? Model.Nome : "Nome do café")
                    </div>
                    <div class="pf-preview-desc" id="previewDesc">
                        @(Model != null && !string.IsNullOrEmpty(Model.Descricao) ? Model.Descricao : "Descrição do produto aparecerá aqui...")
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- FOOTER com botão -->
    <div class="pf-footer">
        <button type="submit" class="pf-btn-submit">
            @(isEdit ? "Atualizar produto →" : "Salvar produto →")
        </button>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {

            $.validator.methods.number = function (value, element) {
                return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:\.\d{3})+)?(?:,\d+)?$/.test(value);
            };
            $.validator.methods.range = function (value, element, param) {
                var globalizedValue = value.replace(".", "").replace(",", ".");
                return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
            };

            // Preview ao vivo
            $('#Nome').on('input', function () {
                var val = $(this).val();
                $('#previewNome').text(val || 'Nome do café');
            });

            $('#Descricao').on('input', function () {
                var val = $(this).val();
                $('#previewDesc').text(val || 'Descrição do produto aparecerá aqui...');
            });

            $('#Preco').on('input', function () {
                var val = $(this).val().replace('.', '').replace(',', '.');
                var num = parseFloat(val);
                $('#previewPreco').text('R$ ' + (isNaN(num) ? '0,00' : num.toLocaleString('pt-BR', { minimumFractionDigits: 2 })));
            });

            $('#fotoUpload').on('change', function () {
                var file = this.files[0];
                if (file) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#previewImg').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}