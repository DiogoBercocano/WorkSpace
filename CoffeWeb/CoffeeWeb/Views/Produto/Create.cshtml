@model CoffeeWeb.Models.Produto
@{
    // VERIFICAÇÃO: Se a Model tem ID > 0, significa que estamos Editando.
    bool isEdit = Model != null && Model.Id > 0;

    // Título dinâmico da aba do navegador
    ViewBag.Title = isEdit ? "Editar Produto" : "Novo Produto";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h2>
            <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
            @(isEdit ? "Editar Café: " + Model.Nome : "Cadastrar Novo Café")
        </h2>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Voltar para a Lista
        </a>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                // ==========================================
                // CAMPOS OCULTOS (Essenciais para o Update funcionar)
                // ==========================================
                if (isEdit)
                {
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.ImagemUrl)
                }<div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nome do Produto</label>
                        @Html.EditorFor(model => model.Nome, new { htmlAttributes = new { @class = "form-control", placeholder = "Ex: Café Mocha" } })
                        @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Preço (R$)</label>
                        @Html.TextBoxFor(model => model.Preco, new { @class = "form-control", placeholder = "Ex: 12,50" })
                        @Html.ValidationMessageFor(model => model.Preco, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Fazer Upload da Foto</label>

                        @if (isEdit && !string.IsNullOrEmpty(Model.ImagemUrl))
                        {
                            <div class="mb-2">
                                <span class="badge bg-secondary mb-1">Foto Atual:</span><br />
                                <img src="@Url.Content(Model.ImagemUrl)" style="width: 80px; height: 80px; object-fit: cover;" class="img-thumbnail" />
                            </div>
                        }
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-upload"></i></span>
                            <input type="file" name="fotoUpload" id="fotoUpload" class="form-control" accept="image/*" />
                        </div>
                        <small class="text-muted">@(isEdit ? "Deixe em branco para manter a foto atual." : "")</small>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Descrição do Produto</label>
                        @Html.TextAreaFor(model => model.Descricao, new { @class = "form-control", rows = "4" })
                        @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12 mt-4 text-end">
                        <button type="submit" class="btn @(isEdit ? "btn-warning" : "btn-success") px-5 py-2 fw-bold">
                            <i class="bi bi-save me-1"></i> @(isEdit ? "Atualizar Produto" : "Salvar Novo Produto")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            $.validator.methods.number = function (value, element) {
                return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:\.\d{3})+)?(?:,\d+)?$/.test(value);
            };
            $.validator.methods.range = function (value, element, param) {
                var globalizedValue = value.replace(".", "").replace(",", ".");
                return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
            };
        });
    </script>
}
