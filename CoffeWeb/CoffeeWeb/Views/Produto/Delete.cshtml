@model CoffeeWeb.Models.Produto
@{
    ViewBag.Title = "Excluir Produto";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --coffee-dark: #1C1208;
            --coffee-mid: #3D2B1A;
            --coffee-warm: #7A4F2D;
            --coffee-gold: #C9923A;
            --coffee-cream: #F5ECD7;
            --coffee-light: #FAF6EE;
            --coffee-muted: #9A8070;
            --danger: #8B2500;
            --danger-bg: rgba(180,50,30,0.07);
            --danger-border: rgba(180,50,30,0.2);
        }

        body {
            background: var(--coffee-light);
            font-family: 'DM Sans', sans-serif;
            color: var(--coffee-dark);
        }

        /* ── HEADER ── */
        .dl-header {
            padding: 2rem 3rem;
            border-bottom: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .dl-eyebrow {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--danger);
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dl-eyebrow::before {
                content: '';
                display: block;
                width: 20px;
                height: 1px;
                background: var(--danger);
            }

        .dl-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin: 0;
            line-height: 1.2;
        }

            .dl-title em {
                font-style: italic;
                color: var(--danger);
            }

        .dl-btn-back {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--coffee-muted);
            text-decoration: none;
            border: 1px solid rgba(122,79,45,0.2);
            padding: 0.6rem 1.25rem;
            border-radius: 2px;
            transition: border-color 0.2s, color 0.2s;
            letter-spacing: 0.03em;
        }

            .dl-btn-back:hover {
                border-color: var(--coffee-dark);
                color: var(--coffee-dark);
                text-decoration: none;
            }

        /* ── AVISO ── */
        .dl-warning {
            margin: 2rem 3rem;
            padding: 1.25rem 1.5rem;
            background: var(--danger-bg);
            border-left: 3px solid var(--danger);
            border-radius: 2px;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .dl-warning-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(180,50,30,0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .dl-warning-icon svg {
                width: 16px;
                height: 16px;
            }

        .dl-warning-text strong {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--danger);
            display: block;
            margin-bottom: 2px;
        }

        .dl-warning-text span {
            font-size: 0.8rem;
            color: var(--danger);
            font-weight: 300;
            opacity: 0.8;
        }

        /* ── CARD DO PRODUTO ── */
        .dl-body {
            padding: 0 3rem 2rem;
            display: grid;
            grid-template-columns: 240px 1fr;
            gap: 2rem;
            align-items: start;
        }

        .dl-img-wrap {
            border: 1px solid rgba(122,79,45,0.12);
            border-radius: 2px;
            overflow: hidden;
            aspect-ratio: 1;
            background: var(--coffee-mid);
        }

        .dl-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            filter: grayscale(20%);
        }

        .dl-img-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .dl-img-placeholder svg {
                width: 48px;
                height: 48px;
                opacity: 0.3;
            }

        .dl-info {
            border: 1px solid rgba(122,79,45,0.12);
            border-radius: 2px;
            overflow: hidden;
            background: white;
        }

        .dl-info-row {
            display: flex;
            border-bottom: 1px solid rgba(122,79,45,0.08);
            align-items: baseline;
        }

            .dl-info-row:last-child {
                border-bottom: none;
            }

        .dl-info-key {
            font-size: 0.7rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--coffee-muted);
            padding: 1rem 1.25rem;
            width: 130px;
            flex-shrink: 0;
            border-right: 1px solid rgba(122,79,45,0.08);
        }

        .dl-info-val {
            padding: 1rem 1.25rem;
            font-size: 0.9rem;
            color: var(--coffee-dark);
            flex: 1;
        }

            .dl-info-val.nome {
                font-family: 'Playfair Display', serif;
                font-size: 1.15rem;
                font-weight: 700;
            }

            .dl-info-val.preco {
                font-family: 'Playfair Display', serif;
                font-weight: 700;
                color: var(--coffee-warm);
            }

            .dl-info-val.desc {
                font-weight: 300;
                color: var(--coffee-muted);
                line-height: 1.6;
            }

        .dl-id-badge {
            display: inline-block;
            background: var(--coffee-dark);
            color: var(--coffee-cream);
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            padding: 0.2rem 0.6rem;
            border-radius: 2px;
        }

        /* ── FOOTER ── */
        .dl-footer {
            padding: 1.5rem 3rem;
            border-top: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
            align-items: center;
        }

        .dl-btn-cancel {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--coffee-muted);
            text-decoration: none;
            border: 1px solid rgba(122,79,45,0.2);
            padding: 0.75rem 1.5rem;
            border-radius: 2px;
            transition: border-color 0.2s, color 0.2s;
            letter-spacing: 0.03em;
        }

            .dl-btn-cancel:hover {
                border-color: var(--coffee-dark);
                color: var(--coffee-dark);
                text-decoration: none;
            }

        .dl-btn-delete {
            background: var(--danger);
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.875rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            cursor: pointer;
            border-radius: 2px;
            transition: background 0.2s, transform 0.15s;
        }

            .dl-btn-delete:hover {
                background: #6B1A00;
                transform: translateY(-1px);
            }

        @@media (max-width: 768px) {
            .dl-header {
                padding: 1.5rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .dl-warning {
                margin: 1rem 1.5rem;
            }

            .dl-body {
                padding: 0 1.5rem 1.5rem;
                grid-template-columns: 1fr;
            }

            .dl-footer {
                padding: 1.5rem;
                flex-direction: column-reverse;
            }

            .dl-btn-cancel, .dl-btn-delete {
                width: 100%;
                text-align: center;
            }
        }
    </style>
}

<!-- HEADER -->
<div class="dl-header">
    <div>
        <div class="dl-eyebrow">Ação irreversível</div>
        <h1 class="dl-title">Excluir <em>produto</em></h1>
    </div>
    <a href="@Url.Action("Index")" class="dl-btn-back">← Voltar para a lista</a>
</div>

<!-- AVISO -->
<div class="dl-warning">
    <div class="dl-warning-icon">
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 2L14 13H2L8 2Z" stroke="#8B2500" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M8 7V9.5" stroke="#8B2500" stroke-width="1.5" stroke-linecap="round" />
            <circle cx="8" cy="11.5" r="0.75" fill="#8B2500" />
        </svg>
    </div>
    <div class="dl-warning-text">
        <strong>Tem certeza que deseja excluir este café?</strong>
        <span>Esta ação não poderá ser desfeita. O registro será removido permanentemente do banco de dados.</span>
    </div>
</div>

<!-- PRODUTO -->
<div class="dl-body">
    <div class="dl-img-wrap">
        @if (!string.IsNullOrEmpty(Model.ImagemUrl))
        {
            <img src="@Url.Content(Model.ImagemUrl)" class="dl-img" alt="@Model.Nome" />
        }
        else
        {
            <div class="dl-img-placeholder">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="6" y="10" width="36" height="28" rx="2" stroke="#F5ECD7" stroke-width="2" />
                    <circle cx="18" cy="20" r="4" stroke="#F5ECD7" stroke-width="2" />
                    <path d="M6 32L16 22L24 30L32 22L42 32" stroke="#F5ECD7" stroke-width="2" stroke-linejoin="round" />
                </svg>
            </div>
        }
    </div>

    <div class="dl-info">
        <div class="dl-info-row">
            <div class="dl-info-key">ID</div>
            <div class="dl-info-val"><span class="dl-id-badge">#@Model.Id</span></div>
        </div>
        <div class="dl-info-row">
            <div class="dl-info-key">Nome</div>
            <div class="dl-info-val nome">@Model.Nome</div>
        </div>
        <div class="dl-info-row">
            <div class="dl-info-key">Preço</div>
            <div class="dl-info-val preco">R$ @Model.Preco.ToString("N2")</div>
        </div>
        <div class="dl-info-row">
            <div class="dl-info-key">Descrição</div>
            <div class="dl-info-val desc">@(Model.Descricao ?? "Sem descrição")</div>
        </div>
    </div>
</div>

<!-- FOOTER -->
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="dl-footer">
        <a href="@Url.Action("Index")" class="dl-btn-cancel">Cancelar</a>
        <button type="submit" class="dl-btn-delete">Excluir definitivamente →</button>
    </div>
}