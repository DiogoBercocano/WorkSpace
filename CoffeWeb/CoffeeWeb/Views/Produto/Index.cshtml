@model IEnumerable<CoffeeWeb.Models.Produto>

@{
    ViewBag.Title = "GerenciarProdutos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h2>
            <i class="bi bi-box-seam me-2"></i>
            Gerenciar Cafés
        </h2>

        <a href="@Url.Action("Create", "Produto")" class="btn btn-success fw-bold">
            <i class="bi bi-plus-circle me-1"></i>
            Novo Produto
        </a>
    </div>


    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">

            <form method="get" action="@Url.Action("Index", "Produto")" class="d-flex">

                <input type="text"
                       name="busca"
                       class="form-control me-2"
                       placeholder="Buscar por nome ou descrição do café..."
                       value="@(ViewBag.BuscaAtual ?? "")">

                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-search"></i> Buscar
                </button>

                @if (!string.IsNullOrEmpty(ViewBag.BuscaAtual))
                {
                    <a href="@Url.Action("Index", "Produto")" class="btn btn-outline-secondary ms-2">
                        Limpar
                    </a>
                }

            </form>

        </div>
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped mb-0 align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th width="80">Foto</th>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th width="150">Preço</th>
                            <th width="200" class="text-center">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    Nenhum produto encontrado.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.ImagemUrl)
                                            ? Url.Content("~/Content/img/sem-imagem.png")
                                            : Url.Content(item.ImagemUrl))"
                                             class="img-thumbnail"
                                             style="width:60px;height:60px;object-fit:cover;"
                                             alt="@item.Nome">
                                    </td>

                                    <td class="fw-bold text-primary">
                                        @(item.Nome ?? "Sem nome")
                                    </td>

                                    <td class="text-truncate" style="max-width:250px;">
                                        @(item.Descricao ?? "Sem descrição")
                                    </td>

                                    <td class="text-success fw-bold">
                                        R$ @item.Preco.ToString("N2")
                                    </td>

                                    <td class="text-center">

                                        <a href="@Url.Action("Edit","Produto", new { id = item.Id })"
                                           class="btn btn-sm btn-warning text-dark"
                                           title="Editar">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>

                                        <a href="@Url.Action("Delete","Produto", new { id = item.Id })"
                                           class="btn btn-sm btn-danger"
                                           title="Excluir">
                                            <i class="bi bi-trash"></i> Excluir
                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>