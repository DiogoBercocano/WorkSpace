@model IEnumerable<CoffeeWeb.Models.Produto>

@{
    ViewBag.Title = "Gerenciar Produtos";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --coffee-dark: #1C1208;
            --coffee-mid: #3D2B1A;
            --coffee-warm: #7A4F2D;
            --coffee-gold: #C9923A;
            --coffee-cream: #F5ECD7;
            --coffee-light: #FAF6EE;
            --coffee-muted: #9A8070;
        }

        body {
            background: var(--coffee-light);
            font-family: 'DM Sans', sans-serif;
            color: var(--coffee-dark);
        }

        /* ── HEADER ── */
        .pr-header {
            padding: 2rem 3rem;
            border-bottom: 1px solid rgba(122,79,45,0.12);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .pr-eyebrow {
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            color: var(--coffee-gold);
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pr-eyebrow::before {
                content: '';
                display: block;
                width: 20px;
                height: 1px;
                background: var(--coffee-gold);
            }

        .pr-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--coffee-dark);
            margin: 0;
            line-height: 1.2;
        }

            .pr-title em {
                font-style: italic;
                color: var(--coffee-warm);
            }

        .pr-btn-new {
            background: var(--coffee-dark);
            color: var(--coffee-cream);
            border: none;
            padding: 0.75rem 1.5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.05em;
            cursor: pointer;
            text-decoration: none;
            border-radius: 2px;
            transition: background 0.2s, transform 0.15s;
            display: inline-block;
        }

            .pr-btn-new:hover {
                background: var(--coffee-mid);
                transform: translateY(-1px);
                color: var(--coffee-cream);
                text-decoration: none;
            }

        /* ── BUSCA ── */
        .pr-search {
            padding: 1.5rem 3rem;
            border-bottom: 1px solid rgba(122,79,45,0.12);
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .pr-search-input {
            flex: 1;
            padding: 0.75rem 1rem;
            border: 1px solid rgba(122,79,45,0.2);
            border-radius: 2px;
            background: white;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.875rem;
            color: var(--coffee-dark);
            outline: none;
            transition: border-color 0.2s;
        }

            .pr-search-input:focus {
                border-color: var(--coffee-gold);
            }

            .pr-search-input::placeholder {
                color: rgba(154,128,112,0.5);
            }

        .pr-search-btn {
            background: var(--coffee-dark);
            color: var(--coffee-cream);
            border: none;
            padding: 0.75rem 1.5rem;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            border-radius: 2px;
            transition: background 0.2s;
            letter-spacing: 0.05em;
        }

            .pr-search-btn:hover {
                background: var(--coffee-mid);
            }

        .pr-search-clear {
            font-size: 0.8rem;
            color: var(--coffee-muted);
            text-decoration: none;
            border: 1px solid rgba(122,79,45,0.2);
            padding: 0.75rem 1rem;
            border-radius: 2px;
            transition: color 0.2s, border-color 0.2s;
        }

            .pr-search-clear:hover {
                color: var(--coffee-dark);
                border-color: var(--coffee-dark);
                text-decoration: none;
            }

        /* ── TABELA ── */
        .pr-table-wrap {
            padding: 2rem 3rem;
        }

        .pr-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid rgba(122,79,45,0.12);
            border-radius: 2px;
            overflow: hidden;
        }

            .pr-table thead tr {
                background: var(--coffee-dark);
            }

            .pr-table thead th {
                font-family: 'DM Sans', sans-serif;
                font-size: 0.7rem;
                font-weight: 500;
                letter-spacing: 0.1em;
                text-transform: uppercase;
                color: var(--coffee-muted);
                padding: 1rem 1.25rem;
                text-align: left;
                border: none;
            }

                .pr-table thead th.center {
                    text-align: center;
                }

            .pr-table tbody tr {
                border-bottom: 1px solid rgba(122,79,45,0.08);
                transition: background 0.15s;
            }

                .pr-table tbody tr:last-child {
                    border-bottom: none;
                }

                .pr-table tbody tr:hover {
                    background: var(--coffee-cream);
                }

            .pr-table tbody td {
                padding: 1rem 1.25rem;
                font-size: 0.875rem;
                color: var(--coffee-dark);
                vertical-align: middle;
            }

                .pr-table tbody td.center {
                    text-align: center;
                }

        .pr-img {
            width: 52px;
            height: 52px;
            object-fit: cover;
            border-radius: 2px;
            border: 1px solid rgba(122,79,45,0.12);
        }

        .pr-nome {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--coffee-dark);
        }

        .pr-desc {
            color: var(--coffee-muted);
            font-weight: 300;
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pr-preco {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: var(--coffee-warm);
        }

        .pr-acoes {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
        }

        .pr-btn-edit {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--coffee-dark);
            background: var(--coffee-cream);
            border: 1px solid rgba(122,79,45,0.2);
            padding: 0.4rem 0.9rem;
            border-radius: 2px;
            text-decoration: none;
            transition: background 0.2s, border-color 0.2s;
            letter-spacing: 0.03em;
        }

            .pr-btn-edit:hover {
                background: #EAD9B8;
                border-color: var(--coffee-gold);
                color: var(--coffee-dark);
                text-decoration: none;
            }

        .pr-btn-delete {
            font-size: 0.75rem;
            font-weight: 500;
            color: #8B2500;
            background: rgba(180,50,30,0.08);
            border: 1px solid rgba(180,50,30,0.2);
            padding: 0.4rem 0.9rem;
            border-radius: 2px;
            text-decoration: none;
            transition: background 0.2s;
            letter-spacing: 0.03em;
        }

            .pr-btn-delete:hover {
                background: rgba(180,50,30,0.15);
                color: #8B2500;
                text-decoration: none;
            }

        .pr-empty {
            text-align: center;
            padding: 4rem;
            color: var(--coffee-muted);
        }

        .pr-empty-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            color: var(--coffee-dark);
            margin-bottom: 0.5rem;
        }

        .pr-empty-desc {
            font-size: 0.85rem;
            font-weight: 300;
        }

        @@media (max-width: 768px) {
            .pr-header {
                padding: 1.5rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .pr-search {
                padding: 1rem 1.5rem;
                flex-wrap: wrap;
            }

            .pr-table-wrap {
                padding: 1rem 1.5rem;
                overflow-x: auto;
            }
        }
    </style>
}

<!-- HEADER -->
<div class="pr-header">
    <div>
        <div class="pr-eyebrow">Área administrativa</div>
        <h1 class="pr-title">Gerenciar <em>Cafés</em></h1>
    </div>
    <a href="@Url.Action("Create", "Produto")" class="pr-btn-new">+ Novo produto</a>
</div>

<!-- BUSCA -->
<div class="pr-search">
    <form method="get" action="@Url.Action("Index", "Produto")" style="display:flex;gap:0.75rem;flex:1;align-items:center;">
        <input type="text"
               name="busca"
               class="pr-search-input"
               placeholder="Buscar por nome ou descrição..."
               value="@(ViewBag.BuscaAtual ?? "")" />
        <button type="submit" class="pr-search-btn">Buscar →</button>
        @if (!string.IsNullOrEmpty(ViewBag.BuscaAtual))
        {
            <a href="@Url.Action("Index", "Produto")" class="pr-search-clear">Limpar</a>
        }
    </form>
</div>

<!-- TABELA -->
<div class="pr-table-wrap">
    <table class="pr-table">
        <thead>
            <tr>
                <th style="width:70px;">Foto</th>
                <th>Nome</th>
                <th>Descrição</th>
                <th style="width:130px;">Preço</th>
                <th class="center" style="width:180px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="5">
                        <div class="pr-empty">
                            <div class="pr-empty-title">Nenhum produto encontrado</div>
                            <p class="pr-empty-desc">Tente outro termo ou adicione um novo produto.</p>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.ImagemUrl)
                                ? Url.Content("~/Content/img/sem-imagem.png")
                                : Url.Content(item.ImagemUrl))"
                                 class="pr-img"
                                 alt="@item.Nome" />
                        </td>
                        <td><span class="pr-nome">@(item.Nome ?? "Sem nome")</span></td>
                        <td><span class="pr-desc">@(item.Descricao ?? "Sem descrição")</span></td>
                        <td><span class="pr-preco">R$ @item.Preco.ToString("N2")</span></td>
                        <td class="center">
                            <div class="pr-acoes">
                                <a href="@Url.Action("Edit", "Produto", new { id = item.Id })" class="pr-btn-edit">Editar</a>
                                <a href="@Url.Action("Delete", "Produto", new { id = item.Id })" class="pr-btn-delete">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>