<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewBag.Title - Coffee Web</title>

    <!-- CSS -->
    @Styles.Render("~/Content/css")

    <!-- GARANTE seu CSS custom -->
    <link href="~/Content/site.css" rel="stylesheet" />

    <!-- Scripts -->
    @Scripts.Render("~/bundles/modernizr")
    @RenderSection("Styles", required: false)
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm">
        <div class="container">

            @Html.ActionLink("☕ Coffee Web", "Index", "Home", null, new { @class = "navbar-brand fw-bold" })

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        @Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Cardápio", "Index", "Cardapio", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Admin", "Index", "Produto", null, new { @class = "nav-link" })
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <!-- CONTEÚDO -->
    <div class="container body-content mt-4">
        @RenderBody()

        <hr />

        <footer class="text-center text-muted small">
            <p>&copy; @DateTime.Now.Year - Coffee Web</p>
        </footer>
    </div>

    <!-- SCRIPTS -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

</body>
</html>